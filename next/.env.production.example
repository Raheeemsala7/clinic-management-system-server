# ==============================================================================
# بيئة الإنتاج (Production Environment Variables)
# قم بتعيين هذه المتغيرات في منصة الاستضافة (Vercel, Railway, VPS, Docker, إلخ)
# ==============================================================================

# مدة الجلسة بالثواني (900 ثانية = 15 دقيقة، 28800 = 8 ساعات، 86400 = 24 ساعة)
# تنبيه: ممنوع وضع فاصلة منقوطة (;) في نهاية القيمة
NEXTAUTH_SESSION_MAX_AGE=900

# عنوان الـ Backend API في الإنتاج (يجب أن يكون HTTPS أو نطاق رسمي)
API_URL=https://api.yourclinic.com/api/v1

# مفتاح التشفير السري لـ NextAuth (يجب توليده عشوائياً بأمر: openssl rand -base64 32)
NEXTAUTH_SECRET=REPLACE_WITH_GENERATED_STRONG_SECRET_FOR_PROD

# الرابط الأساسي للفرونت إند في الإنتاج (ضروري جداً مع بروتوكول https://)
NEXTAUTH_URL=https://yourclinic.com

# اسم الكوكي في بيئة الإنتاج المشفرة HTTPS
NEXT_AUTH_SESSION_COOKIE_NAME=__Secure-next-auth.session-token
