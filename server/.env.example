# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (Neon) ───────────────────────────────────────────────────────────
# Pooled connection string – used by the running application
# The pooled host contains "-pooler" in its hostname
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require

# Direct (non-pooled) connection string – used ONLY by Prisma migrate / seed
# Same as DATABASE_URL but without "-pooler" in the hostname
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')|>console.log"
# Minimum 32 characters; use 64-byte hex (128 chars) in production
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_STRING
JWT_REFRESH_TTL=604800

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ─── Clinic / Locale ──────────────────────────────────────────────────────────
CLINIC_TIMEZONE=Africa/Cairo
CURRENCY_CODE=EGP

# ─── File Storage ─────────────────────────────────────────────────────────────
# 'local' or 's3'
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# S3-compatible (only required when STORAGE_DRIVER=s3)
# S3_ENDPOINT=https://your-s3-endpoint
# S3_REGION=us-east-1
# S3_BUCKET=clinic-attachments
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_FORCE_PATH_STYLE=false

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=5

# ─── Seed Credentials ──────────────────────────────────────────────────────────
# After running db:seed, read the actual credentials from server/.env (NOT from here)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SEED_DOCTOR_USERNAME=doctor
SEED_DOCTOR_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SEED_RECEPTION_USERNAME=reception
SEED_RECEPTION_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
