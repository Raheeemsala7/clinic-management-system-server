{
  "name": "clinic-management-api",
  "version": "1.0.0",
  "description": "Single-doctor clinic management system backend",
  "author": "Clinic Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc",
    "vercel-build": "tsc",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "ts-node src/server.ts",
    "dev": "ts-node src/server.ts",
    "start:dev": "ts-node src/server.ts",
    "start:prod": "node dist/src/server.js",
    "seed": "ts-node src/scripts/seed.ts",
    "db:seed": "ts-node src/scripts/seed.ts"
  },
  "dependencies": {
    "argon2": "0.31.2",
    "cors": "^2.8.6",
    "dayjs": "^1.11.10",
    "decimal.js": "^10.4.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "file-type": "^16.5.4",
    "helmet": "^7.1.0",
    "joi": "^17.12.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vercel/node": "^24.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "<rootDir>/../node_modules/ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "\\.module\\.ts$",
      "main\\.ts",
      "\\.dto\\.ts$",
      "\\.entity\\.ts$"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
