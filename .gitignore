# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Environment files (NEVER commit real secrets) ────────────────────────────
.env
.env.*
!.env.example
# .env.example IS committed intentionally. All other .env / .env.* are ignored.

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
.next/

# ─── Local file uploads ───────────────────────────────────────────────────────
uploads/

# ─── Test coverage ────────────────────────────────────────────────────────────
coverage/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Prisma ──────────────────────────────────────────────────────────────────
# Migrations are committed; only local SQLite dev db is ignored
prisma/migrations/dev.db

# ─── TypeScript incremental cache ────────────────────────────────────────────
*.tsbuildinfo
