# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://clinic_user:clinic_pass@localhost:5432/clinic_db

# Test database (used for e2e tests – separate DB to avoid data pollution)
TEST_DATABASE_URL=postgresql://clinic_user:clinic_pass@localhost:5432/clinic_db_test

# ─── JWT ────────────────────────────────────────────────────────────────────────
# Access token secret (min 32 chars in production)
JWT_ACCESS_SECRET=change_me_in_production_access_secret_32_chars_min
# Access token TTL in seconds (default: 900 = 15 minutes)
JWT_ACCESS_TTL=900

# Refresh token secret (min 32 chars in production)
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret_32_chars_min
# Refresh token TTL in seconds (default: 604800 = 7 days)
JWT_REFRESH_TTL=604800

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ─── Clinic / Localisation ──────────────────────────────────────────────────────
# IANA timezone for computing "clinic day"
CLINIC_TIMEZONE=Africa/Cairo

# ISO 4217 currency code
CURRENCY_CODE=EGP

# ─── File Storage ───────────────────────────────────────────────────────────────
# 'local' or 's3'
STORAGE_DRIVER=local

# Local storage base path (relative or absolute)
LOCAL_STORAGE_PATH=./uploads

# S3-compatible storage (only needed when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=clinic-attachments
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Rate Limiting ───────────────────────────────────────────────────────────────
# Global rate limit (requests per minute per IP)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Auth login rate limit (per IP+username per minute)
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=5

# ─── Seeding ─────────────────────────────────────────────────────────────────────
# Seed script will print these once. Change before first run.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DOCTOR_USERNAME=doctor
SEED_DOCTOR_PASSWORD=Doctor@12345
SEED_RECEPTION_USERNAME=reception
SEED_RECEPTION_PASSWORD=Recept@12345
