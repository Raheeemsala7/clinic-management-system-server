# ─── Server-only (NEVER prefix with NEXT_PUBLIC_) ─────────────────────────────
# The base URL of the NestJS API, used only in Server Components and Server Actions.
# The browser never calls the backend directly.
API_BASE_URL=http://localhost:4000/api/v1

# Cookie secret for signing session tokens (min 32 chars)
COOKIE_SECRET=REPLACE_WITH_RANDOM_32_CHAR_STRING

# ─── Public (safe for browser bundle) ─────────────────────────────────────────
# Socket.IO server URL, used by the useQueueRealtime hook via the ticket mechanism.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
